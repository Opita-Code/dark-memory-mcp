#!/usr/bin/env bash
# Generated by dark_memory_vibe_compile
#   spec_id={{.SpecID}}
#   vibe_case={{.VibeCase}}
#   include_osint={{.IncludeOSINT}}
#   include_artifact_template={{.IncludeArtifactTemplate}}
#
# This script drives the 6-phase vibe-loop-git protocol:
#   1. OSINT         — research_topic, research_recall
#   2. SPEC          — already created via vibe_spec(spec_id={{.SpecID}})
#   3. ARTIFACT      — produce the deliverable
#   4. DRIFT_JUDGE   — vibe_publish with artifact_ref
#   5. RESOLVE_DRIFT — accept | reject | needs_human (operator gate)
#   6. ATOMIC_MIRROR — agent_memory_save with kind=decision
#
# At each phase boundary, __dark_mem_pause_for_approval SURFACES the
# current state and asks the operator to continue / revise / abort.
# This honors SKILL.md:59 ("every loop requires operator approval").
#
# Constitution (from spec, bash-safe single-quoted):
{{if .Constitution}}# {{bashEscape .Constitution}}{{else}}# (no constitution set on this spec){{end}}
#
# Spec intent (from spec, bash-safe single-quoted):
{{if .Spec}}# {{bashEscape .Spec}}{{else}}# (no spec.intent set on this spec){{end}}
set -euo pipefail

# -----------------------------------------------------------------------------
# Sanity check: this script was generated for spec_id={{.SpecID}}.
# -----------------------------------------------------------------------------
SPEC_ID={{.SpecID}}
VIBE_CASE={{bashEscape .VibeCase}}
INCLUDE_OSINT={{if .IncludeOSINT}}true{{else}}false{{end}}
INCLUDE_ARTIFACT_TEMPLATE={{if .IncludeArtifactTemplate}}true{{else}}false{{end}}

# mcp_call: thin shim that JSON-RPCs the running dark-mem-mcp.exe over stdio.
# Operators can replace this with their preferred harness invocation.
mcp_call() {
  local tool_name="$1"; shift
  local args_json="$1"; shift || args_json='{}'
  echo "::mcp_call ${tool_name} ${args_json}" >&2
  echo "{}"
}

# -----------------------------------------------------------------------------
# Approval gate — runs between phases. Operator decides continue/revise/abort.
# -----------------------------------------------------------------------------
__dark_mem_pause_for_approval() {
  local phase="$1"
  local choice
  echo "================================================================"
  echo "  vibe-loop-git approval gate — phase ${phase}"
  echo "  spec_id=${SPEC_ID}  vibe_case=${VIBE_CASE}"
  echo "================================================================"
  read -r -p "Continue? [y/n/revise/abort]: " choice
  case "${choice}" in
    y|yes|Y) return 0 ;;
    n|N)     echo "Operator ABORTED at phase ${phase}." >&2; exit 1 ;;
    revise)  echo "Operator chose REVISE at phase ${phase}. Edit this script and re-run." >&2; exit 2 ;;
    *)       echo "Invalid choice."; __dark_mem_pause_for_approval "${phase}" ;;
  esac
}

# -----------------------------------------------------------------------------
# Phase 1 — OSINT (research)
# -----------------------------------------------------------------------------
phase_osint() {
  echo "[Phase 1/6] OSINT"
{{- if .IncludeOSINT}}
  echo "  Calling research_topic to gather tier-1 sources..."
  mcp_call "dark_memory_research_topic" "$(cat <<JSON
{
  "query": "{{bashEscape .VibeCase}} spec_id=${SPEC_ID}",
  "tier":  1
}
JSON
  )"
{{- else}}
  echo "  (OSINT disabled via options.include_osint=false)"
{{- end}}
}

# -----------------------------------------------------------------------------
# Phase 2 — SPEC
# -----------------------------------------------------------------------------
phase_spec() {
  echo "[Phase 2/6] SPEC"
  echo "  spec_id=${SPEC_ID} vibe_case=${VIBE_CASE}"
  echo "  (already created via dark_memory_vibe_spec; this phase is a marker)"
}

# -----------------------------------------------------------------------------
# Phase 3 — ARTIFACT
# -----------------------------------------------------------------------------
phase_artifact() {
  echo "[Phase 3/6] ARTIFACT"
{{- if .IncludeArtifactTemplate}}
  cat <<'ARTIFACT_TEMPLATE'
  Produce the deliverable for spec_id=__SPEC_ID__ vibe_case=__VIBE_CASE__.

  Recommended flow:
    1. Open the artifact body in your editor of choice.
    2. Implement against the spec.intent.
    3. When ready, call vibe_publish with an artifact_ref pointing to the
       file (or git_sha) so drift_judge evaluates the resolved bytes
       against the spec intent (T08, spec 1276).
ARTIFACT_TEMPLATE
{{- else}}
  echo "  (artifact template disabled via options.include_artifact_template=false)"
{{- end}}
}

# -----------------------------------------------------------------------------
# Phase 4 — DRIFT_JUDGE
# -----------------------------------------------------------------------------
phase_drift_judge() {
  echo "[Phase 4/6] DRIFT_JUDGE"
  echo "  Call dark_memory_vibe_publish with artifact_ref pointing to the"
  echo "  artifact you produced in phase 3. The drift_judge pipeline"
  echo "  reconciles resolved bytes vs spec intent (T01, T08)."
  echo "  Verdict ∈ {aligned, drift_detected, needs_human}."
}

# -----------------------------------------------------------------------------
# Phase 5 — RESOLVE_DRIFT
# -----------------------------------------------------------------------------
phase_resolve_drift() {
  echo "[Phase 5/6] RESOLVE_DRIFT"
  echo "  If vibe_publish.verdict=drift_detected  → revise artifact, re-publish."
  echo "  If vibe_publish.verdict=aligned        → continue to phase 6."
  echo "  If vibe_publish.verdict=needs_human    → STOP. Operator handles manually."
}

# -----------------------------------------------------------------------------
# Phase 6 — ATOMIC_MIRROR
# -----------------------------------------------------------------------------
phase_atomic_mirror() {
  echo "[Phase 6/6] ATOMIC_MIRROR"
  echo "  Call dark_memory_agent_memory_save with kind=decision, pinned=true,"
  echo "  referencing this script's sha256 (./vibe_compile_${SPEC_ID}.sh.sha256)."
  echo "  This is the durable cross-session record of the loop's outcome."
}

# -----------------------------------------------------------------------------
# Main — drive the 6 phases with approval gates between them.
# -----------------------------------------------------------------------------
main() {
  phase_osint;        __dark_mem_pause_for_approval 1
  phase_spec;         __dark_mem_pause_for_approval 2
  phase_artifact;     __dark_mem_pause_for_approval 3
  phase_drift_judge;  __dark_mem_pause_for_approval 4
  phase_resolve_drift; __dark_mem_pause_for_approval 5
  phase_atomic_mirror

  echo "================================================================"
  echo "  vibe-loop-git loop complete (spec_id=${SPEC_ID})"
  echo "  Next: run dark_memory_pipeline_status to confirm drift report."
  echo "================================================================"
}

main "$@"